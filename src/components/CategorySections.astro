---
import { getCollection } from 'astro:content';

const categories = [
  {
    id: 'ai',
    title: 'AI Agent',
    desc: '从 Prompt、RAG 到生产级 Agent 系统',
    href: '/ai/prompt-engineering/',
  },
  {
    id: 'ai-workflow',
    title: 'AI 工作流',
    desc: 'AI Coding、Skills 与开发工具链',
    href: '/ai-workflow/ai-coding-skills-selection-guide/',
  },
  {
    id: 'architecture',
    title: 'Architecture',
    desc: '分布式系统、事件驱动与业务建模',
    href: '/architecture/distributed-transaction/',
  },
  {
    id: 'claw',
    title: 'OpenClaw',
    desc: '插件开发、模型接入与生产部署',
    href: '/claw/openclaw/',
  },
  {
    id: 'ai-news',
    title: 'AI News',
    desc: '每周 AI 工程变化与趋势判断',
    href: '/ai-news/',
  },
  {
    id: 'java',
    title: 'Java',
    desc: '并发、框架、中间件与架构实践',
    href: '/java/01-core/1-java21-virtual-threads/',
  },
  {
    id: 'algorithms',
    title: '算法',
    desc: '用模式组织高频题，而不是背题解',
    href: '/algorithms/java-high-frequency-algorithm-patterns/',
  },
  {
    id: 'ops',
    title: 'Ops',
    desc: 'Kubernetes、排障与生产运行手册',
    href: '/ops/k8s/kubernetes-practical-starter-guide/',
  },
  {
    id: 'network',
    title: '网络',
    desc: '网络协议与 AI Agent 通信',
    href: '/network/ai-agent-communication-protocols/',
  },
  {
    id: 'security',
    title: '安全',
    desc: '漏洞机制、风险判断与处置',
    href: '/security/1-zero-day-vulnerability-primer/',
  },
];

const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  return match ? new Date(match[1]) : null;
}

function getFilenameOrder(id: string): number {
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? Number.parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  return parseDateFromFilename(doc.id)?.getTime() ?? 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryId: string, count = 4) {
  return allDocs
    .filter((doc) => isArticle(doc) && doc.id.startsWith(`${categoryId}/`))
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      return dateDiff || getFilenameOrder(b.id) - getFilenameOrder(a.id);
    })
    .slice(0, count);
}

function getDocHref(id: string) {
  return `/${id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
}

const articleDocs = allDocs.filter(isArticle);
const sections = categories.map((category) => ({
  ...category,
  docs: getCategoryDocs(category.id),
  count: articleDocs.filter((doc) => doc.id.startsWith(`${category.id}/`)).length,
}));

const recentDocs = [...articleDocs]
  .sort((a, b) => getDocDate(b) - getDocDate(a))
  .slice(0, 4);

const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});

function formatDate(doc: typeof allDocs[number]) {
  const timestamp = getDocDate(doc);
  if (!timestamp) return '';
  return compactDateFormatter.format(new Date(timestamp)).replace('/', '.');
}

function getCategoryTitle(id: string) {
  const categoryId = id.split('/')[0];
  return categories.find((category) => category.id === categoryId)?.title ?? '笔记';
}
---

<header class="directory-intro">
  <div class="intro-copy">
    <p class="directory-eyebrow"><span aria-hidden="true"></span>AI Agent Engineering Notes</p>
    <h1>AI Agent 工程笔记</h1>
    <p class="directory-lead">记录从 Prompt、RAG、工具调用到生产运行的判断、实现和复盘。</p>
  </div>

  <dl class="directory-stats" aria-label="博客概况">
    <div>
      <dt>{articleDocs.length}</dt>
      <dd>篇笔记</dd>
    </div>
    <div>
      <dt>{categories.length}</dt>
      <dd>个主题</dd>
    </div>
    <div>
      <dt><span class="status-dot" aria-hidden="true"></span>持续</dt>
      <dd>更新中</dd>
    </div>
  </dl>
</header>

<section class="recent-panel" aria-labelledby="recent-title">
  <header class="panel-heading">
    <p>Latest</p>
    <h2 id="recent-title">最近更新</h2>
  </header>

  <ol class="recent-list">
    {recentDocs.map((doc) => (
      <li>
        <a href={getDocHref(doc.id)}>
          <span class="recent-meta">
            <span>{getCategoryTitle(doc.id)}</span>
            {formatDate(doc) && <time datetime={new Date(getDocDate(doc)).toISOString()}>{formatDate(doc)}</time>}
          </span>
          <span class="recent-title">{doc.data.title}</span>
          <span class="recent-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<section class="topic-index" aria-labelledby="topic-title">
  <header class="topic-heading">
    <div>
      <p>Topics</p>
      <h2 id="topic-title">按主题阅读</h2>
    </div>
    <p class="topic-note">每个主题列出最近四篇</p>
  </header>

  <div class="home-sections">
    {sections.map((category) => (
      <section class="section-card" aria-labelledby={`section-${category.id}`}>
        <a href={category.href} class="section-header">
          <span class="section-title-row">
            <span class="section-marker" aria-hidden="true"></span>
            <span class="section-title" id={`section-${category.id}`}>{category.title}</span>
            <span class="section-count">{category.count}</span>
            <span class="section-arrow" aria-hidden="true">↗</span>
          </span>
          <span class="section-desc">{category.desc}</span>
        </a>

        {category.docs.length > 0 && (
          <ul class="section-list">
            {category.docs.map((doc) => (
              <li class="section-item">
                <a href={getDocHref(doc.id)} class="section-link">
                  <span class="section-link-title">{doc.data.title}</span>
                  {formatDate(doc) && <time datetime={new Date(getDocDate(doc)).toISOString()}>{formatDate(doc)}</time>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</section>

<style>
  .directory-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
    align-items: end;
    gap: clamp(2.5rem, 7vw, 7rem);
    padding: clamp(3.5rem, 7vw, 6.25rem) 0 clamp(3rem, 5vw, 4.5rem);
  }

  .intro-copy {
    position: relative;
    max-width: 47rem;
    padding-left: clamp(1.25rem, 2.6vw, 2rem);
    border-left: 2px solid var(--sl-color-accent);
  }

  .intro-copy::before {
    content: '';
    position: absolute;
    left: -0.31rem;
    top: -0.05rem;
    width: 0.52rem;
    height: 0.52rem;
    border: 2px solid var(--sl-color-bg);
    border-radius: 50%;
    background: var(--sl-color-accent);
  }

  .directory-eyebrow,
  .panel-heading p,
  .topic-heading > div > p {
    margin: 0;
    color: var(--sl-color-accent-high);
    font-family: var(--sl-font-utility);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .directory-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .directory-eyebrow span {
    width: 1.6rem;
    height: 1px;
    background: var(--sl-color-accent);
  }

  .directory-intro h1 {
    max-width: 13ch;
    margin: 1rem 0 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: clamp(2.65rem, 5.2vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .directory-lead {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    line-height: 1.75;
    text-wrap: pretty;
  }

  .directory-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0 0 0.25rem;
  }

  .directory-stats div {
    min-width: 0;
    padding-left: 1rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }

  .directory-stats dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-heading);
    font-size: 1.08rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .directory-stats dd {
    margin: 0.28rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
  }

  .status-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px var(--sl-color-accent-low);
  }

  .recent-panel {
    display: grid;
    grid-template-columns: minmax(9rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.35rem, 2.5vw, 2rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-surface);
    box-shadow: 0 16px 40px rgba(23, 32, 51, 0.045);
  }

  .panel-heading h2,
  .topic-heading h2 {
    margin: 0.45rem 0 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: 1.24rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .recent-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recent-list li {
    min-width: 0;
    margin: 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .recent-list li:nth-child(-n + 2) {
    border-top: 0;
  }

  .recent-list a {
    position: relative;
    display: block;
    min-width: 0;
    padding: 0.72rem 1.3rem 0.72rem 0;
    color: inherit;
    text-decoration: none;
  }

  .recent-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-utility);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .recent-title {
    display: block;
    margin-top: 0.32rem;
    overflow: hidden;
    color: var(--sl-color-gray-1);
    font-size: 0.9rem;
    line-height: 1.45;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .recent-arrow {
    position: absolute;
    right: 0;
    bottom: 0.78rem;
    color: var(--sl-color-accent);
    font-size: 0.78rem;
    opacity: 0;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .recent-list a:hover .recent-title {
    color: var(--sl-color-accent-high);
  }

  .recent-list a:hover .recent-arrow {
    opacity: 1;
    transform: translate(0.1rem, -0.1rem);
  }

  .topic-index {
    margin: clamp(3.5rem, 6vw, 5.5rem) 0 3rem;
  }

  .topic-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .topic-note {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
  }

  .home-sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2.5rem, 6vw, 6rem);
  }

  .section-card {
    min-width: 0;
    padding: clamp(1.65rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .section-header {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .section-marker {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 auto;
    border-radius: 1px;
    background: var(--sl-color-accent);
  }

  .section-title {
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: clamp(1.18rem, 1.6vw, 1.38rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
    transition: color 0.18s ease;
  }

  .section-count {
    margin-left: auto;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-utility);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .section-arrow {
    color: var(--sl-color-accent);
    font-size: 0.8rem;
    opacity: 0;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .section-header:hover .section-title {
    color: var(--sl-color-accent-high);
  }

  .section-header:hover .section-arrow {
    opacity: 1;
    transform: translate(0.1rem, -0.1rem);
  }

  .section-desc {
    display: block;
    margin: 0.55rem 0 0 1.07rem;
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .section-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .section-item {
    margin: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0 -0.5rem;
    padding: 0.43rem 0.5rem;
    border-radius: 5px;
    color: var(--sl-color-gray-1);
    text-decoration: none;
    transition: color 0.18s ease, background-color 0.18s ease;
  }

  .section-link:hover {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }

  .section-link-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.88rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-utility);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 800px) {
    .directory-intro {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .directory-stats {
      max-width: 27rem;
    }

    .recent-panel {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .home-sections {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .directory-intro {
      padding: 2.75rem 0 2.5rem;
    }

    .intro-copy {
      padding-left: 1rem;
    }

    .directory-intro h1 {
      font-size: clamp(2.45rem, 13vw, 3.25rem);
    }

    .directory-lead {
      margin-top: 1rem;
      font-size: 0.95rem;
    }

    .directory-stats div {
      padding-left: 0.7rem;
    }

    .recent-panel {
      padding: 1.25rem;
    }

    .recent-list {
      grid-template-columns: 1fr;
    }

    .recent-list li:nth-child(2) {
      border-top: 1px solid var(--sl-color-gray-6);
    }

    .topic-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.55rem;
    }

    .section-card {
      padding: 1.55rem 0;
    }

    .section-link-title {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recent-arrow,
    .section-arrow,
    .section-title,
    .section-link {
      transition: none;
    }
  }
</style>
