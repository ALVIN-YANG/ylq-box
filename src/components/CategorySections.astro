const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  if (typeof id !== 'string') return null;
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  if (match) return new Date(match[1]);
  return null;
}

function getFilenameOrder(id: string): number {
  if (typeof id !== 'string') return 0;
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  const parsed = parseDateFromFilename(doc.id);
  if (parsed) return parsed.getTime();
  return 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryId: string, count = 5) {
  return allDocs
    .filter((doc) => {
      if (!isArticle(doc)) return false;
      return doc.id.startsWith(`${categoryId}/`);
    })
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      if (dateDiff !== 0) return dateDiff;
      return getFilenameOrder(b) - getFilenameOrder(a);
    })
    .slice(0, count);
}

const sections = categories.map((cat) => ({
  ...cat,
  docs: getCategoryDocs(cat.id),
  count: allDocs.filter((doc) => isArticle(doc) && doc.id.startsWith(`${cat.id}/`)).length,
}));

const compactDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: '2-digit',
  day: '2-digit',
});

function formatDate(doc: typeof allDocs[number]) {
  const value = doc.data.lastUpdated || doc.data.date;
  if (!value) return '';
  return compactDateFormatter.format(new Date(value)).replace('/', '.');
}
---

<header class="directory-intro">
  <div>
    <p class="directory-kicker">WRITING INDEX</p>
    <h2>按主题浏览</h2>
  </div>
  <p class="directory-note">从 Agent 到基础设施，每个分栏保留最近更新的文章。</p>
</header>

<div class="home-sections" aria-label="文章分栏">
  {
    sections.map((cat, index) => (
      <section class="section-card" aria-labelledby={`section-${cat.id}`}>
        <span class="section-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>

        <a href={cat.href} class="section-header">
          <span class="section-title-row">
            <span class="section-title" id={`section-${cat.id}`}>{cat.title}</span>
            <span class="section-arrow" aria-hidden="true">↗</span>
          </span>
          <span class="section-desc">{cat.desc}</span>
          <span class="section-count">{cat.count} 篇文章</span>
        </a>

        {cat.docs.length > 0 && (
          <ul class="section-list">
            {cat.docs.map((doc) => {
              const href = `/${doc.id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
              return (
                <li class="section-item">
                  <a href={href} class="section-link">
                    <span class="section-link-title">{doc.data.title}</span>
                    <time datetime={new Date(doc.data.lastUpdated || doc.data.date || 0).toISOString()}>{formatDate(doc)}</time>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .directory-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(15rem, 0.85fr);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: clamp(2.7rem, 6vw, 5rem) 0 1.25rem;
  }

  .directory-intro h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: clamp(1.8rem, 3.4vw, 2.65rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .directory-kicker {
    margin: 0 0 0.5rem;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .directory-note {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .home-sections {
    margin: 0 0 2.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  @media (max-width: 720px) {
    .directory-intro {
      grid-template-columns: 1fr;
      gap: 0.45rem;
      margin-top: 1.25rem;
      margin-bottom: 0.8rem;
      padding-bottom: 0.2rem;
    }

    .directory-intro h2 {
      font-size: 1.8rem;
    }

  }

  .section-card {
    display: grid;
    grid-template-columns: 2.25rem minmax(10.5rem, 0.68fr) minmax(0, 1.7fr);
    align-items: start;
    gap: clamp(1rem, 2.6vw, 2.75rem);
    margin: 0;
    padding: 1.5rem 0 1.65rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    animation: sectionFadeIn 0.4s ease-out both;
    transition: border-color 0.2s ease;
  }

  .section-card:hover {
    border-bottom-color: color-mix(in srgb, var(--sl-color-accent) 50%, var(--sl-color-gray-5));
  }

  .section-index {
    padding-top: 0.2rem;
    color: var(--sl-color-gray-4);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .section-header {
    display: block;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .section-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .section-header:hover .section-title {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .section-header:hover .section-arrow {
    opacity: 1;
    transform: translate(0.12rem, -0.12rem);
  }

  .section-arrow {
    color: var(--sl-color-accent);
    font-size: 0.8rem;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .section-title {
    display: block;
    font-family: var(--sl-font-heading);
    font-size: clamp(1.28rem, 1.8vw, 1.5rem);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.025em;
    transition: color 0.2s ease;
  }

  .section-desc {
    display: block;
    max-width: 19rem;
    margin-top: 0.45rem;
    color: var(--sl-color-gray-2);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .section-count {
    display: block;
    margin-top: 0.7rem;
    color: var(--sl-color-gray-2);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .section-list {
    list-style: none;
    margin: -0.15rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3rem);
  }

  .section-item {
    margin: 0;
    padding: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    margin: 0 -0.45rem;
    padding: 0.42rem 0.45rem;
    text-decoration: none;
    color: var(--sl-color-gray-1);
    border-radius: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .section-link:hover {
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    border-bottom-color: var(--sl-color-accent);
  }

  .section-link:hover time {
    color: var(--sl-color-accent-high);
  }

  .section-link-title {
    min-width: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-2);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .section-link:focus-visible,
  .section-header:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card {
      animation: none;
    }
  }

  @media (max-width: 800px) {
    .section-card {
      grid-template-columns: 1.75rem minmax(8.5rem, 0.72fr) minmax(0, 1.4fr);
      gap: 0.9rem;
    }

    .section-list {
      grid-template-columns: 1fr;
    }

    .section-item:nth-child(n + 4) {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .section-card {
      grid-template-columns: 1.6rem minmax(0, 1fr);
      gap: 0.8rem;
      padding: 1.25rem 0 1.35rem;
    }

    .section-header {
      padding-right: 0.25rem;
    }

    .section-list {
      grid-column: 2;
      margin-top: 0.15rem;
    }

    .section-count {
      margin-top: 0.5rem;
    }
  }
</style>
