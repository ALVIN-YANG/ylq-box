const allDocs = await getCollection('docs');

function parseDateFromFilename(id: string): Date | null {
  if (typeof id !== 'string') return null;
  const match = id.match(/(\d{4}-\d{2}-\d{2})/);
  if (match) return new Date(match[1]);
  return null;
}

function getFilenameOrder(id: string): number {
  if (typeof id !== 'string') return 0;
  const numMatch = id.match(/\/(\d{1,2})-/);
  return numMatch ? parseInt(numMatch[1], 10) : 0;
}

function getDocDate(doc: typeof allDocs[number]): number {
  if (doc.data.lastUpdated) return new Date(doc.data.lastUpdated).getTime();
  if (doc.data.date) return new Date(doc.data.date).getTime();
  const parsed = parseDateFromFilename(doc.id);
  if (parsed) return parsed.getTime();
  return 0;
}

function isArticle(doc: typeof allDocs[number]) {
  const id = doc.id;
  return Boolean(id && !id.endsWith('index') && !id.includes('_category_') && id !== 'index.mdx');
}

function getCategoryDocs(categoryId: string, count = 5) {
  return allDocs
    .filter((doc) => {
      if (!isArticle(doc)) return false;
      return doc.id.startsWith(`${categoryId}/`);
    })
    .sort((a, b) => {
      const dateDiff = getDocDate(b) - getDocDate(a);
      if (dateDiff !== 0) return dateDiff;
      return getFilenameOrder(b) - getFilenameOrder(a);
    })
    .slice(0, count);
}

const sections = categories.map((cat) => ({
  ...cat,
  docs: getCategoryDocs(cat.id),
  count: allDocs.filter((doc) => isArticle(doc) && doc.id.startsWith(`${cat.id}/`)).length,
}));

const articleCount = allDocs.filter(isArticle).length;

function formatDate(doc: typeof allDocs[number]) {
  const value = doc.data.lastUpdated || doc.data.date;
  if (!value) return '';
  const date = new Date(value);
  return `${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
}
---

<header class="directory-intro">
  <div>
    <p class="directory-kicker">Alvin Yang · Field Notes</p>
    <h1>分栏</h1>
    <p class="directory-lead">关于 AI Agent、软件架构与工程实践的持续笔记。</p>
  </div>
  <p class="directory-count"><strong>{articleCount}</strong> 篇文章 · {sections.length} 个分栏</p>
</header>

<div class="home-sections" aria-label="文章分栏">
  {
    sections.map((cat) => (
      <section class="section-card" aria-labelledby={`section-${cat.id}`}>
        <div class="section-heading">
          <a href={cat.href} class="section-header">
            <span class="section-icon" set:html={cat.icon} />
            <span>
              <span class="section-title" id={`section-${cat.id}`}>{cat.title}</span>
              <span class="section-desc">{cat.desc}</span>
            </span>
          </a>
          <span class="section-count">{cat.count}</span>
        </div>

        {cat.docs.length > 0 && (
          <ul class="section-list">
            {cat.docs.map((doc) => {
              const href = `/${doc.id.replace(/\.mdx?$/, '').replace(/\/index$/, '/')}/`;
              return (
                <li class="section-item">
                  <a href={href} class="section-link">
                    <span class="section-link-title">{doc.data.title}</span>
                    <time datetime={new Date(doc.data.lastUpdated || doc.data.date || 0).toISOString()}>{formatDate(doc)}</time>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))
  }
</div>

<style>
  .directory-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin: clamp(2rem, 5vw, 4.5rem) 0 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .directory-kicker {
    margin: 0 0 0.45rem;
    color: var(--sl-color-accent);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .directory-intro h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-family: var(--sl-font-heading);
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .directory-lead {
    margin: 0.7rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .directory-count {
    flex: 0 0 auto;
    margin: 0;
    color: var(--sl-color-gray-3);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .directory-count strong {
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 600;
  }

  .home-sections {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    align-items: start;
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: 0;
    margin: 0 0 2rem;
  }

  @media (max-width: 720px) {
    .directory-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1.75rem;
      margin-bottom: 1rem;
      padding-bottom: 1.25rem;
    }

    .home-sections {
      grid-template-columns: 1fr;
      column-gap: 0;
    }
  }

  .section-card {
    margin: 0;
    padding: 1.35rem 0 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    animation: sectionFadeIn 0.4s ease-out both;
  }

  .section-card:nth-child(-n + 2) {
    border-top-color: var(--sl-color-accent);
  }

  .section-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .section-header:hover .section-title {
    color: var(--sl-color-accent);
  }

  .section-icon {
    flex-shrink: 0;
    color: var(--sl-color-accent);
    display: flex;
    align-items: center;
    margin-top: 0.1rem;
  }

  .section-title {
    display: block;
    font-family: var(--sl-font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0;
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .section-desc {
    display: block;
    margin-top: 0.25rem;
    color: var(--sl-color-gray-3);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .section-count {
    flex: 0 0 auto;
    color: var(--sl-color-gray-4);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .section-list {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .section-item {
    margin: 0;
    padding: 0;
  }

  .section-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem 0;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .section-link:hover {
    color: var(--sl-color-accent);
    transform: translateX(0.2rem);
  }

  .section-link-title {
    min-width: 0;
    font-size: 0.84rem;
    line-height: 1.45;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section-link time {
    color: var(--sl-color-gray-4);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .section-link:focus-visible,
  .section-header:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  @keyframes sectionFadeIn {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-card {
      animation: none;
    }
  }
</style>
