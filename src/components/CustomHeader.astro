---
import type { Props } from '@astrojs/starlight/props';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const knowledgeEntry = { label: 'Agent 知识体系', href: '/agent-knowledge/', match: '/agent-knowledge/' };

const navLinks = [
  { label: '文章', href: '/', match: '/' },
  { label: 'AI Agent', href: '/ai/function-call-agent/', match: '/ai/' },
  knowledgeEntry,
  { label: 'AI 工作流', href: '/ai-workflow/ai-coding-skills-selection-guide/', match: '/ai-workflow/' },
  { label: 'Skills', href: '/skills/', match: '/skills/' },
  { label: '模型榜', href: '/model-arena/', match: '/model-arena' },
  { label: '关于', href: '/about/', match: '/about/' },
];

const currentPath = Astro.url.pathname;

function isActive(match: string): boolean {
  if (match === '/') return currentPath === '/';
  if (match === '/algorithms/') return currentPath.startsWith('/algorithms/') || currentPath.startsWith('/java/');
  if (match === '/ai-workflow/') return currentPath.startsWith('/ai-workflow/');
  return currentPath.startsWith(match);
}
---

<div class="header sl-flex">
  <div class="title-wrapper sl-flex">
    <SiteTitle {...Astro.props} />
  </div>
  <div class="sl-flex spacer"></div>
  <nav class="sl-flex nav-links">
    {navLinks.map(link => (
      <a href={link.href} class:list={[{ active: isActive(link.match) }]}>{link.label}</a>
    ))}
  </nav>
  <div class="sl-flex right-group-mobile md:sl-hidden">
    <a class="knowledge-entry-mobile" href={knowledgeEntry.href}>知识体系</a>
    <ThemeToggle />
  </div>
  <div class="sl-hidden md:sl-flex right-group">
    <Search {...Astro.props} />
    <div class="sl-flex social-icons">
      <SocialIcons {...Astro.props} />
    </div>
    <ThemeToggle />
  </div>
</div>

<reading-progress aria-hidden="true" hidden>
  <span></span>
</reading-progress>

<style>
  .header {
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .title-wrapper {
    position: relative;
    overflow: hidden;
    padding-left: 0.78rem;
  }
  .title-wrapper::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 1px;
    background: var(--sl-color-accent);
    transform: translateY(-50%);
  }
  .right-group {
    gap: 0.8rem;
    align-items: center;
  }
  .social-icons {
    gap: 1rem;
    align-items: center;
  }

  /* ── Desktop Nav ── */
  .nav-links {
    gap: 0.18rem;
    align-items: center;
    display: none;
    flex-wrap: nowrap;
    justify-content: center;
  }
  @media (min-width: 50rem) {
    .nav-links {
      display: flex;
    }
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    font-weight: 560;
    font-size: 0.82rem;
    padding: 0.45rem 0.56rem;
    border-radius: 5px;
    white-space: nowrap;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav-links a:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-accent-low);
  }
  .nav-links a.active {
    color: var(--sl-color-accent-high);
    background-color: transparent;
  }
  .nav-links a.active::after {
    content: '';
    position: absolute;
    left: 0.56rem;
    right: 0.56rem;
    bottom: 0.12rem;
    height: 2px;
    border-radius: 99px;
    background: var(--sl-color-accent);
  }

  reading-progress {
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    display: block;
    height: 2px;
    overflow: hidden;
    pointer-events: none;
  }

  reading-progress[hidden] {
    display: none;
  }

  reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* ── Mobile right group ── */
  .right-group-mobile {
    align-items: center;
    gap: 0.5rem;
  }
  .knowledge-entry-mobile {
    position: relative;
    padding: 0.32rem 0.5rem 0.32rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    color: var(--sl-color-gray-1);
    background: var(--sl-color-surface);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .knowledge-entry-mobile::before {
    content: '';
    position: absolute;
    left: 0.42rem;
    top: 50%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    transform: translateY(-50%);
  }
</style>

<script>
  class ReadingProgress extends HTMLElement {
    abortController = new AbortController();
    article: HTMLElement | null = null;
    bar: HTMLElement | null = null;
    frame = 0;

    connectedCallback() {
      if (document.documentElement.hasAttribute('data-has-hero')) return;

      this.article = document.querySelector('main .sl-markdown-content');
      this.bar = this.querySelector('span');
      if (!this.article || !this.bar) return;

      this.hidden = false;
      const signal = this.abortController.signal;
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true, signal });
      window.addEventListener('resize', this.scheduleUpdate, { passive: true, signal });
      this.scheduleUpdate();
    }

    disconnectedCallback() {
      this.abortController.abort();
      window.cancelAnimationFrame(this.frame);
    }

    scheduleUpdate = () => {
      if (this.frame) return;
      this.frame = window.requestAnimationFrame(this.renderProgress);
    };

    renderProgress = () => {
      this.frame = 0;
      if (!this.article || !this.bar) return;

      const articleTop = window.scrollY + this.article.getBoundingClientRect().top;
      const start = articleTop - 120;
      const end = articleTop + this.article.offsetHeight - window.innerHeight * 0.72;
      const progress = end <= start ? 1 : (window.scrollY - start) / (end - start);
      const clamped = Math.min(1, Math.max(0, progress));
      this.bar.style.transform = `scaleX(${clamped})`;
    };
  }

  if (!customElements.get('reading-progress')) {
    customElements.define('reading-progress', ReadingProgress);
  }
</script>
