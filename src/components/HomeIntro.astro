---
const focusAreas = ['AI Agent', '系统设计', '工程实践'];
---

<section class="home-intro not-content" aria-labelledby="home-intro-title">
  <div class="home-copy">
    <p class="home-kicker"><span aria-hidden="true"></span> ALVIN YANG / SOFTWARE ENGINEER</p>
    <h1 id="home-intro-title">写 Agent，也写软件怎么长期跑下去。</h1>
    <p class="home-description">
      这里记录我做 AI Agent、后端和基础设施时遇到的问题。文章尽量保留源码、数据和验证结果。
    </p>

    <nav class="home-actions" aria-label="首页入口">
      <a class="primary-action" href="/claw/openclaw/">从 OpenClaw 开始 <span aria-hidden="true">↗</span></a>
      <a class="secondary-action" href="/about/">关于我 <span aria-hidden="true">→</span></a>
    </nav>

    <ul class="focus-list" aria-label="主要写作方向">
      {focusAreas.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <figure class="home-portrait">
    <div class="portrait-paper">
      <span class="portrait-mark" aria-hidden="true">AY</span>
      <img
        src="/images/brand/alvin-programmer.webp"
        alt="戴半框眼镜、穿短袖短裤和凉鞋的程序员插画"
        width="1024"
        height="1024"
        decoding="async"
        fetchpriority="high"
      />
      <span class="portrait-line" aria-hidden="true"></span>
    </div>
    <figcaption>
      <span class="caption-label">CURRENTLY</span>
      <span>Agent、工具与长期运行系统</span>
    </figcaption>
  </figure>
</section>

<style>
  .home-intro {
    --home-ink: #26303c;
    --home-navy: #384b62;
    --home-navy-deep: #29394c;
    --home-sand: #b08a62;
    --home-paper: #fbfaf5;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.72fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
    min-height: clamp(31rem, 66vh, 40rem);
    padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2.75rem, 6vw, 5.25rem);
    border-bottom: 1px solid var(--sl-color-gray-5);
    color: var(--home-ink);
  }

  .home-kicker {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin: 0 0 1.15rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    line-height: 1.4;
  }

  .home-kicker span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--home-sand);
    box-shadow: 0 0 0 0.28rem rgba(176, 138, 98, 0.12);
  }

  h1,
  p {
    margin: 0;
  }

  h1 {
    max-width: 10.5ch;
    color: var(--home-ink);
    font-family: var(--sl-font-heading);
    font-size: clamp(2.9rem, 6vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .home-description {
    max-width: 35rem;
    margin-top: 1.45rem;
    color: var(--sl-color-gray-2);
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.85;
    text-wrap: pretty;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.35rem;
    align-items: center;
    margin-top: 1.8rem;
  }

  .home-actions a {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.75rem;
    color: var(--home-ink);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .primary-action {
    padding: 0.7rem 1rem;
    border: 1px solid var(--home-navy-deep);
    border-radius: 0.35rem;
    background: var(--home-navy-deep);
    color: #fff !important;
  }

  .primary-action:hover {
    background: var(--home-navy);
    border-color: var(--home-navy);
    transform: translateY(-1px);
  }

  .secondary-action {
    padding-inline: 0.15rem;
    border-bottom: 1px solid var(--home-sand);
  }

  .secondary-action:hover {
    color: var(--home-navy) !important;
  }

  .home-actions a span {
    color: var(--home-sand);
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: clamp(2.7rem, 6vw, 4.2rem) 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    list-style: none;
  }

  .focus-list li + li::before {
    margin: 0 0.75rem;
    color: var(--home-sand);
    content: '/';
  }

  .home-portrait {
    position: relative;
    width: min(100%, 27rem);
    margin: 0;
    justify-self: end;
  }

  .portrait-paper {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 0.88;
    border: 1px solid #d8d4c8;
    border-radius: 48% 48% 0.85rem 0.85rem;
    background: var(--home-paper);
    box-shadow:
      0.8rem 0.8rem 0 rgba(176, 138, 98, 0.16),
      0 1.4rem 3rem rgba(38, 48, 60, 0.08);
  }

  .portrait-paper::before {
    position: absolute;
    inset: 8% 8% 14%;
    z-index: -1;
    border: 1px solid rgba(56, 75, 98, 0.18);
    border-radius: 50%;
    content: '';
    transform: rotate(-5deg);
  }

  .portrait-paper img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }

  .portrait-mark {
    position: absolute;
    top: 1.35rem;
    left: 1.35rem;
    z-index: 1;
    color: rgba(56, 75, 98, 0.58);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .portrait-line {
    position: absolute;
    right: 1.35rem;
    bottom: 1.45rem;
    z-index: 1;
    width: 2.4rem;
    height: 1px;
    background: var(--home-sand);
    transform: rotate(-8deg);
  }

  figcaption {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.8rem;
    margin: 1rem 0.15rem 0;
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .caption-label {
    color: var(--home-sand);
    font-family: var(--sl-font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .home-actions a:focus-visible {
    outline: 2px solid var(--home-navy);
    outline-offset: 0.3rem;
  }

  @media (max-width: 48rem) {
    .home-intro {
      grid-template-columns: 1fr minmax(14rem, 0.7fr);
      gap: 2rem;
    }

    h1 {
      font-size: clamp(2.5rem, 8vw, 3.75rem);
    }
  }

  @media (max-width: 40rem) {
    .home-intro {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 2rem;
    }

    .home-copy {
      display: contents;
    }

    .home-kicker,
    h1,
    .home-description,
    .home-actions {
      grid-column: 1;
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(2.45rem, 12vw, 3.35rem);
    }

    .home-description {
      margin-top: 1.1rem;
    }

    .home-actions {
      margin-top: 1.35rem;
    }

    .home-portrait {
      width: min(84vw, 22rem);
      margin-top: 0.85rem;
      justify-self: center;
    }

    .focus-list {
      order: 3;
      margin-top: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-actions a {
      transition: none;
    }
  }
</style>
