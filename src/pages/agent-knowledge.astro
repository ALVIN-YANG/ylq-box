---
import AgentKnowledgeMap from '../components/AgentKnowledgeMap.astro';
import '../styles/agent-knowledge-mintlify.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="从系统运行关系出发，浏览并串联 AI Agent 开发所需的知识点。"
    />
    <meta name="theme-color" content="#f5f6f7" />
    <link rel="icon" href="/favicon.png" />
    <title>AI Agent 知识体系</title>
  </head>
  <body>
    <main class="standalone-knowledge-page">
      <AgentKnowledgeMap />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --sl-font-utility: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --sl-font-mono: "Geist Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  * { box-sizing: border-box; }

  html {
    min-width: 320px;
    background: #f5f6f7;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: #f5f6f7;
  }

  button,
  input { font: inherit; }

  .standalone-knowledge-page {
    min-height: 100svh;
    padding: 0;
  }

  .standalone-knowledge-page > .knowledge-explorer {
    width: 100%;
  }
</style>
