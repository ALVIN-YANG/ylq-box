---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import data from '../data/model-arena.json';

const tabs = [
  { key: 'overall', label: '总榜', note: '至少覆盖 2 个独立来源' },
  { key: 'general', label: '通用', note: '综合知识与推理' },
  { key: 'code', label: '代码', note: 'Web 开发与软件工程' },
  { key: 'agent', label: 'Agent', note: '终端与知识工作' },
] as const;

const activeBoards = data.sourceBoards.filter((board) => board.status !== 'stale');
const hasPricing = data.models.some((model) => Boolean(model.pricing));
type LivePricing = { input: number; output: number };
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});

function shortDate(value: string | null) {
  return value ? value.slice(0, 10) : '—';
}

function sourceTime(value: string) {
  return dateFormatter.format(new Date(value));
}
---

<StarlightPage frontmatter={{ title: '实时模型榜', description: '汇总持续更新的公开评测，保留每个模型的来源、原始成绩与覆盖情况。', template: 'splash' }} sidebar={[]}>
  <main class="arena-shell">
    <section class="ledger-head" aria-label="榜单数据状态">
      <div class="ledger-summary">
        <div class="live-line"><span class="live-dot"></span>实时汇总</div>
        <p>{data.methodology.operatorCount} 个独立来源 · {data.methodology.boardCount} 张榜单 · 检查于 {data.checkedAt} · 内容更新于 {data.updatedAt}</p>
      </div>
      <a class="method-link" href="/model-arena/methodology/">评分方法与来源说明 <span aria-hidden="true">→</span></a>
    </section>

    <div class="source-rail" aria-label="当前数据来源">
      {data.sourceBoards.map((board) => (
        <a class:list={['source-node', `is-${board.status}`]} href={board.sourceUrl} target="_blank" rel="noreferrer">
          <span class="source-code">{board.short}</span>
          <span class="source-name">{board.label}</span>
          <span class="source-meta">{board.status === 'live' ? '实时' : board.status === 'cached' ? '缓存' : '过期'} · {sourceTime(board.updatedAt)}</span>
        </a>
      ))}
    </div>

    <div class="board-toolbar">
      <div class="board-tabs" role="tablist" aria-label="模型榜单分类">
        {tabs.map((tab, index) => (
          <button
            class:list={['board-tab', { active: index === 0 }]}
            id={`tab-${tab.key}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.key}`}
            data-tab={tab.key}
          >
            <span>{tab.label}</span>
            <small>{tab.note}</small>
          </button>
        ))}
      </div>
      <p class="coverage-help"><span class="coverage-sample"><i></i><i></i><i></i><i></i><i></i></span> 色块表示该模型被哪些榜单收录</p>
    </div>

    {tabs.map((tab, tabIndex) => (
      <section
        class:list={['board-panel', { active: tabIndex === 0 }]}
        id={`panel-${tab.key}`}
        role="tabpanel"
        aria-labelledby={`tab-${tab.key}`}
        hidden={tabIndex !== 0}
        data-panel={tab.key}
      >
        <div class="table-wrap">
          <table class="model-table">
            <thead>
              <tr>
                <th scope="col">排名</th>
                <th scope="col">模型</th>
                <th scope="col">发布时间</th>
                <th scope="col">来源覆盖</th>
                {hasPricing && <th scope="col" class="price-head">价格 / 1M tokens</th>}
                <th scope="col" class="score-head">共识分</th>
              </tr>
            </thead>
            <tbody>
              {data.leaderboards[tab.key].map((model, index) => (
                <tr class:list={{ podium: index < 3 }}>
                  <td class="rank-cell" data-label="排名"><span>{String(index + 1).padStart(2, '0')}</span></td>
                  <td class="model-cell" data-label="模型">
                    <a href={`/model-arena/${model.slug}/`}>{model.name}</a>
                    <small>{model.organization}</small>
                  </td>
                  <td class="date-cell" data-label="发布时间">{shortDate(model.releaseDate)}</td>
                  <td class="coverage-cell" data-label="来源覆盖">
                    <div class="coverage-track" aria-label={`覆盖 ${model.sourceCount} / ${activeBoards.length} 张榜单`}>
                      {activeBoards.map((board) => (
                        <span class:list={{ covered: model.evidenceSources.includes(board.id) }} title={`${board.label}${model.evidenceSources.includes(board.id) ? '：已收录' : '：未收录'}`}></span>
                      ))}
                    </div>
                    <small>{model.sourceCount}/{activeBoards.length}</small>
                  </td>
                  {hasPricing && (
                    <td class="price-cell" data-label="价格">
                      {(model.pricing as LivePricing | null) ? `$${(model.pricing as LivePricing).input.toFixed(2)} / $${(model.pricing as LivePricing).output.toFixed(2)}` : '—'}
                    </td>
                  )}
                  <td class="score-cell" data-label="共识分">
                    <strong>{model.score.toFixed(1)}</strong><span>/100</span>
                    <a href={`/model-arena/${model.slug}/`} aria-label={`查看 ${model.name} 的评测证据`}>证据 →</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <footer class="arena-note">
      <p>榜单只汇总能自动更新、能回到原始结果的数据。缺少某张榜不会直接扣分，但会降低来源覆盖。</p>
      <a href="/model-arena/methodology/">查看归并规则、计算方式和数据状态</a>
    </footer>
  </main>

  <script is:inline>
    const tabs = Array.from(document.querySelectorAll('[data-tab]'));
    const panels = Array.from(document.querySelectorAll('[data-panel]'));

    function activateBoard(key, updateHash) {
      tabs.forEach(function (tab) {
        const active = tab.getAttribute('data-tab') === key;
        tab.classList.toggle('active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
      });
      panels.forEach(function (panel) {
        const active = panel.getAttribute('data-panel') === key;
        panel.classList.toggle('active', active);
        panel.hidden = !active;
      });
      if (updateHash) history.replaceState(null, '', key === 'overall' ? location.pathname : '#' + key);
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () { activateBoard(tab.getAttribute('data-tab'), true); });
      tab.addEventListener('keydown', function (event) {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const nextIndex = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[nextIndex].focus();
        activateBoard(tabs[nextIndex].getAttribute('data-tab'), true);
      });
    });

    const initial = location.hash.slice(1);
    activateBoard(tabs.some(function (tab) { return tab.getAttribute('data-tab') === initial; }) ? initial : 'overall', false);
  </script>
</StarlightPage>

<style>
  .arena-shell {
    --ink: #252a2d;
    --muted: #737a78;
    --line: #deddd4;
    --paper: rgba(255, 255, 252, 0.72);
    --live: #478576;
    --live-soft: #dfece6;
    --warm: #b66b48;
    width: min(100%, 76rem);
    margin-inline: auto;
    padding: 0 0 3rem;
    color: var(--ink);
  }

  .ledger-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: 0.9rem 1rem;
    border-block: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(255,255,255,.55), transparent);
  }

  .live-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 4px var(--live-soft);
  }

  .ledger-summary p {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  .method-link,
  .arena-note a {
    color: #4f635b;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .method-link:hover,
  .arena-note a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .source-rail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin-bottom: 1.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .source-node {
    position: relative;
    display: grid;
    gap: 0.12rem;
    min-width: 0;
    padding: 0.8rem 0.9rem 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid var(--line);
  }

  .source-node:last-child { border-right: 0; }
  .source-node::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--live); opacity: 0.75; }
  .source-node.is-cached::before { background: #bd8b4f; }
  .source-node.is-stale::before { background: #a3a5a2; }
  .source-node:hover { background: rgba(255,255,255,.72); }
  .source-node:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }
  .source-code { color: var(--live); font-family: var(--sl-font-mono); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.08em; }
  .source-name { overflow: hidden; font-size: 0.78rem; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .source-meta { color: var(--muted); font-family: var(--sl-font-mono); font-size: 0.64rem; }

  .board-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }

  .board-tabs { display: flex; gap: 0.25rem; }
  .board-tab {
    display: grid;
    gap: 0.1rem;
    min-width: 7.4rem;
    padding: 0.65rem 0.8rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
  }
  .board-tab span { color: inherit; font-size: 0.92rem; font-weight: 700; }
  .board-tab small { font-size: 0.67rem; white-space: nowrap; }
  .board-tab:hover { color: var(--ink); background: rgba(255,255,255,.45); }
  .board-tab.active { color: var(--ink); border-bottom-color: var(--warm); }
  .board-tab:focus-visible { outline: 2px solid var(--live); outline-offset: 2px; }

  .coverage-help {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .coverage-sample { display: flex; gap: 2px; }
  .coverage-sample i { width: 7px; height: 5px; background: var(--live); }
  .coverage-sample i:nth-child(4), .coverage-sample i:nth-child(5) { background: #d9d8d0; }

  .board-panel[hidden] { display: none; }
  .table-wrap { overflow-x: auto; border-block: 1px solid var(--line); background: rgba(255,255,252,.52); }
  .model-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .model-table th {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-align: left;
  }
  .model-table th:first-child { width: 5rem; }
  .model-table th:nth-child(2) { width: 35%; }
  .model-table th:nth-child(3) { width: 9rem; }
  .model-table th:nth-child(4) { width: 13rem; }
  .model-table th:last-child { width: 10rem; text-align: right; }
  .model-table td { padding: 0.78rem 0.75rem; border-bottom: 1px solid rgba(222,221,212,.8); vertical-align: middle; }
  .model-table tbody tr:last-child td { border-bottom: 0; }
  .model-table tbody tr:hover { background: rgba(255,255,255,.72); }
  .model-table tbody tr.podium { background-image: linear-gradient(90deg, rgba(182,107,72,.055), transparent 45%); }

  .rank-cell span { color: #929590; font-family: var(--sl-font-mono); font-size: 0.82rem; }
  .podium .rank-cell span { color: var(--warm); font-weight: 800; }
  .model-cell a { display: block; overflow: hidden; color: var(--ink); font-size: 0.9rem; font-weight: 700; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
  .model-cell a:hover { color: #705542; text-decoration: underline; text-underline-offset: 0.18em; }
  .model-cell small { display: block; margin-top: 0.1rem; color: var(--muted); font-size: 0.69rem; }
  .date-cell { color: #666c69; font-family: var(--sl-font-mono); font-size: 0.72rem; }
  .price-cell { color: #666c69; font-family: var(--sl-font-mono); font-size: 0.69rem; white-space: nowrap; }

  .coverage-cell { white-space: nowrap; }
  .coverage-track { display: inline-flex; gap: 3px; vertical-align: middle; }
  .coverage-track span { width: 1.35rem; height: 0.38rem; background: #d9d8d0; }
  .coverage-track span.covered { background: var(--live); }
  .coverage-cell small { margin-left: 0.45rem; color: var(--muted); font-family: var(--sl-font-mono); font-size: 0.66rem; }

  .score-cell { text-align: right; white-space: nowrap; }
  .score-cell strong { font-family: var(--sl-font-mono); font-size: 1rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .score-cell > span { color: var(--muted); font-family: var(--sl-font-mono); font-size: 0.62rem; }
  .score-cell a { display: block; margin-top: 0.08rem; color: #697a73; font-size: 0.67rem; text-decoration: none; }
  .score-cell a:hover { text-decoration: underline; }

  .arena-note {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.85rem 0.15rem;
    color: var(--muted);
    font-size: 0.76rem;
  }
  .arena-note p { margin: 0; }

  :global([data-theme='dark']) .arena-shell {
    --ink: #e8e6df;
    --muted: #a5aaa7;
    --line: #42443f;
    --paper: rgba(32, 35, 33, 0.64);
    --live-soft: rgba(71,133,118,.22);
  }
  :global([data-theme='dark']) .source-node:hover,
  :global([data-theme='dark']) .model-table tbody tr:hover { background: rgba(255,255,255,.045); }
  :global([data-theme='dark']) .table-wrap { background: rgba(25,28,26,.42); }
  :global([data-theme='dark']) .coverage-track span,
  :global([data-theme='dark']) .coverage-sample i:nth-child(4),
  :global([data-theme='dark']) .coverage-sample i:nth-child(5) { background: #555750; }

  @media (max-width: 52rem) {
    .ledger-head, .board-toolbar, .arena-note { align-items: flex-start; flex-direction: column; }
    .source-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .source-node { border-bottom: 1px solid var(--line); }
    .board-tabs { width: 100%; overflow-x: auto; }
    .board-tab { min-width: 6.6rem; }
    .coverage-help { display: none; }
    .model-table { min-width: 44rem; }
  }

  @media (max-width: 34rem) {
    .source-rail { grid-template-columns: 1fr; }
    .source-node { border-right: 0; }
    .ledger-head { padding-inline: 0.6rem; }
    .table-wrap { overflow: visible; border-top: 1px solid var(--line); }
    .model-table, .model-table tbody { display: block; min-width: 0; }
    .model-table thead { display: none; }
    .model-table tr { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; padding: 0.78rem 0.2rem; border-bottom: 1px solid var(--line); }
    .model-table td { padding: 0.18rem 0.45rem; border: 0; }
    .rank-cell { grid-row: 1 / 3; align-self: center; }
    .model-cell { grid-column: 2; }
    .date-cell { display: none; }
    .coverage-cell { grid-column: 2; }
    .score-cell { grid-column: 3; grid-row: 1 / 3; align-self: center; }
    .coverage-track span { width: 0.8rem; }
    .arena-note { gap: 0.45rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
</style>
