---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import collection from '../data/skill-collection.json';

const categories = ['全部', ...new Set(collection.items.map((item) => item.category))];
---

<StarlightPage frontmatter={{ title: '有趣的 Skills', description: '我收藏和使用的 Agent Skills。', template: 'splash' }} sidebar={[]}>
  <main class="skills-page">
    <nav class="filters" aria-label="按类型筛选">
      {categories.map((category, index) => (
        <button type="button" class:list={['filter', { active: index === 0 }]} data-filter={category} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
      ))}
    </nav>

    <div class="skill-grid" aria-live="polite">
      {collection.items.map((item) => (
        <article class="skill-card" data-category={item.category}>
          <div class="card-topline">
            <span>{item.category}</span>
            <small>{item.owner}</small>
          </div>

          <div class="card-title">
            <h2>{item.displayName}</h2>
            <a href={item.repo} target="_blank" rel="noreferrer" aria-label={`打开 ${item.displayName} GitHub 仓库`}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h5v5"/><path d="M10 14 20 4"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></svg>
            </a>
          </div>

          <p class="summary">{item.summary}</p>
          <p class="reason"><span>收藏理由</span>{item.reason}</p>

          <div class="card-footer">
            <div class="keywords" aria-label="适用场景">
              {item.bestFor.map((tag) => <span>{tag}</span>)}
            </div>
            <button type="button" class="copy-button" data-copy={item.install} aria-label={`复制 ${item.displayName} 安装命令`}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>
              <span>复制安装命令</span>
            </button>
          </div>
        </article>
      ))}
    </div>

    <footer class="page-note">
      <p>安装第三方 Skill 前，先检查 <code>SKILL.md</code>、脚本和权限范围。同类工作流不要一次装太多。</p>
      <a href="/ai-workflow/ai-coding-skills-selection-guide/">Skill 怎么选 →</a>
    </footer>
  </main>

  <script is:inline>
    const filters = Array.from(document.querySelectorAll('[data-filter]'));
    const cards = Array.from(document.querySelectorAll('.skill-card'));

    filters.forEach(function (button) {
      button.addEventListener('click', function () {
        const category = button.getAttribute('data-filter');
        filters.forEach(function (item) {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        cards.forEach(function (card) {
          card.hidden = category !== '全部' && card.getAttribute('data-category') !== category;
        });
      });
    });

    document.querySelectorAll('[data-copy]').forEach(function (button) {
      button.addEventListener('click', function () {
        const command = button.getAttribute('data-copy');
        if (!command) return;
        const label = button.querySelector('span');
        const textarea = document.createElement('textarea');
        textarea.value = command;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          if (!document.execCommand('copy')) throw new Error('copy failed');
          if (label) label.textContent = '已复制';
          button.classList.add('copied');
          window.setTimeout(function () {
            if (label) label.textContent = '复制安装命令';
            button.classList.remove('copied');
          }, 1600);
        } catch (_) {
          if (label) label.textContent = '复制失败';
        } finally {
          textarea.remove();
        }
      });
    });
  </script>
</StarlightPage>

<style>
  .skills-page {
    --card-bg: rgba(255, 255, 252, 0.78);
    --card-border: #deded6;
    --card-text: #292e31;
    --card-muted: #747a7d;
    --card-accent: #566b61;
    width: min(100%, 68rem);
    margin-inline: auto;
    padding-bottom: 3rem;
    color: var(--card-text);
  }

  :global(.article-description),
  :global(.article-meta) { display: none; }

  :global(main > .content-panel:first-of-type) { padding-block: 1rem .5rem; }
  :global(main > .content-panel:first-of-type h1) { font-size: clamp(1.8rem, 3vw, 2.2rem); }
  :global(main > .content-panel + .content-panel) {
    padding-top: .5rem;
    border-top: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-bottom: 1.1rem;
  }

  .filter {
    padding: .38rem .72rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--card-muted);
    font-size: .72rem;
    cursor: pointer;
  }

  .filter:hover { color: var(--card-text); background: rgba(255,255,255,.5); }
  .filter.active { border-color: var(--card-border); background: var(--card-bg); color: var(--card-text); font-weight: 650; }
  .filter:focus-visible,
  .card-title a:focus-visible,
  .copy-button:focus-visible { outline: 2px solid var(--card-accent); outline-offset: 2px; }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    min-height: 20rem;
    padding: 1.25rem;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    background: var(--card-bg);
    box-shadow: 0 1px 2px rgba(30, 35, 32, .025);
    transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;
  }

  .skill-card:hover {
    border-color: #c6c9c2;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(30, 35, 32, .055);
  }

  .skill-card[hidden] { display: none; }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-topline span {
    color: var(--card-accent);
    font-size: .68rem;
    font-weight: 700;
  }

  .card-topline small {
    color: var(--card-muted);
    font-family: var(--sl-font-mono);
    font-size: .62rem;
  }

  .card-title {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .85rem;
  }

  .card-title h2 {
    margin: 0;
    color: var(--card-text);
    font-family: var(--sl-font-heading);
    font-size: 1.18rem;
    font-weight: 650;
    line-height: 1.35;
  }

  .card-title a {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    margin-top: -.25rem;
    border-radius: 6px;
    color: var(--card-muted);
  }

  .card-title a:hover { background: rgba(86,107,97,.08); color: var(--card-accent); }

  .summary {
    margin: .8rem 0 0;
    font-size: .82rem;
    line-height: 1.75;
  }

  .reason {
    margin: .85rem 0 0;
    color: var(--card-muted);
    font-size: .73rem;
    line-height: 1.7;
  }

  .reason span {
    display: block;
    margin-bottom: .18rem;
    color: var(--card-text);
    font-size: .66rem;
    font-weight: 650;
  }

  .card-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(222,222,214,.8);
  }

  .keywords {
    display: flex;
    flex-wrap: wrap;
    gap: .25rem .6rem;
  }

  .keywords span {
    color: var(--card-muted);
    font-size: .64rem;
    white-space: nowrap;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    flex: none;
    padding: .42rem .55rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--card-accent);
    font-size: .66rem;
    font-weight: 650;
    cursor: pointer;
  }

  .copy-button:hover { background: rgba(86,107,97,.08); }
  .copy-button.copied { color: #37725b; }

  .page-note {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.2rem;
    padding-top: 1rem;
    color: var(--card-muted);
    font-size: .7rem;
  }

  .page-note p { max-width: 43rem; margin: 0; line-height: 1.7; }
  .page-note code { font-size: .66rem; }
  .page-note a { flex: none; color: var(--card-accent); font-weight: 650; text-decoration: none; }
  .page-note a:hover { text-decoration: underline; text-underline-offset: .2em; }

  :global([data-theme='dark']) .skills-page {
    --card-bg: rgba(32, 35, 33, .72);
    --card-border: #444740;
    --card-text: #e9e7df;
    --card-muted: #a6aba7;
    --card-accent: #9bb5a8;
  }

  :global([data-theme='dark']) .skill-card:hover { border-color: #5b5f57; box-shadow: 0 10px 24px rgba(0,0,0,.15); }
  :global([data-theme='dark']) .card-footer { border-color: #444740; }

  @media (max-width: 46rem) {
    .skill-grid { grid-template-columns: 1fr; }
    .skill-card { min-height: 18rem; }
  }

  @media (max-width: 30rem) {
    .skill-card { padding: 1rem; }
    .card-footer { align-items: start; flex-direction: column; }
    .copy-button { padding-left: 0; }
    .page-note { flex-direction: column; gap: .5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card { transition: none; }
  }
</style>
