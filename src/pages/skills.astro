---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import collection from '../data/skill-collection.json';

const frontmatter = {
  title: 'Skills',
  description: '我收藏和使用的 Agent Skills。',
  template: 'splash' as const,
  hidePageTitle: true,
};
---

<StarlightPage frontmatter={frontmatter} sidebar={[]}>
  <!-- `not-content` prevents Starlight's prose rhythm from leaking into the UI grid. -->
  <section class="skills-page not-content" aria-labelledby="skills-page-title">
    <header class="page-intro">
      <h1 id="skills-page-title">Skills</h1>
      <p>我实际使用或研究过的 Agent Skills。</p>
    </header>

    <div class="skill-grid">
      {collection.items.map((item) => (
        <article class="skill-card">
          <span class="card-category">{item.category}</span>
          <h2>
            <a href={item.repo} target="_blank" rel="noreferrer" aria-label={`打开 ${item.name} GitHub 仓库`}>
              {item.name}
              <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4h5v5"/><path d="M10 14 20 4"/><path d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"/></svg>
            </a>
          </h2>

          <p class="summary">{item.summary}</p>
          <button type="button" class="copy-button" data-copy={item.install} aria-label={`复制 ${item.name} 安装命令`}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>
            <span>复制安装命令</span>
          </button>
        </article>
      ))}
    </div>

    <footer class="page-note">
      <p>安装第三方 Skill 前，先检查 <code>SKILL.md</code>、脚本和权限范围。同类工作流不要一次装太多。</p>
      <a href="/ai-workflow/ai-coding-skills-selection-guide/">Skill 怎么选 →</a>
    </footer>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach(function (button) {
      button.addEventListener('click', function () {
        const command = button.getAttribute('data-copy');
        if (!command) return;
        const label = button.querySelector('span');
        const textarea = document.createElement('textarea');
        textarea.value = command;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
          if (!document.execCommand('copy')) throw new Error('copy failed');
          if (label) label.textContent = '已复制';
          button.classList.add('copied');
          window.setTimeout(function () {
            if (label) label.textContent = '复制安装命令';
            button.classList.remove('copied');
          }, 1600);
        } catch (_) {
          if (label) label.textContent = '复制失败';
        } finally {
          textarea.remove();
        }
      });
    });
  </script>
</StarlightPage>

<style>
  .skills-page {
    --card-bg: rgba(255, 255, 252, 0.78);
    --card-border: #deded6;
    --card-text: #292e31;
    --card-muted: #747a7d;
    --card-accent: #566b61;
    width: min(100%, 66rem);
    margin-inline: auto;
    padding-bottom: 2rem;
    color: var(--card-text);
  }

  .page-intro {
    margin-bottom: 1.2rem;
  }

  .page-intro h1 {
    margin: 0;
    color: var(--card-text);
    font-family: var(--sl-font-heading);
    font-size: clamp(2rem, 5vw, 3.15rem);
    font-weight: 650;
    letter-spacing: -.045em;
    line-height: 1;
  }

  .page-intro p {
    margin: .55rem 0 0;
    color: var(--card-muted);
    font-size: .82rem;
  }

  .skill-card h2 a:focus-visible,
  .copy-button:focus-visible { outline: 2px solid var(--card-accent); outline-offset: 2px; }

  .skill-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .6rem;
  }

  .skill-card {
    display: flex;
    flex-direction: column;
    min-height: 10.2rem;
    padding: .85rem .9rem .75rem;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    background: var(--card-bg);
    transition: border-color .16s ease, background-color .16s ease;
  }

  .skill-card:hover {
    border-color: #bec5bf;
    background: rgba(255, 255, 252, .96);
  }

  .card-category {
    color: var(--card-accent);
    font-size: .64rem;
    font-weight: 700;
  }

  .skill-card h2 {
    margin: .38rem 0 0;
    font-family: var(--sl-font-heading);
    font-size: 1.25rem;
    font-weight: 680;
    line-height: 1.25;
  }

  .skill-card h2 a {
    display: inline-flex;
    align-items: center;
    gap: .34rem;
    color: var(--card-text);
    text-decoration: none;
  }

  .skill-card h2 svg {
    flex: none;
    color: var(--card-muted);
    transition: transform .16s ease, color .16s ease;
  }

  .skill-card h2 a:hover { color: var(--card-accent); }
  .skill-card h2 a:hover svg { color: currentColor; transform: translate(1px, -1px); }

  .summary {
    margin: .48rem 0 0;
    color: var(--card-muted);
    font-size: .75rem;
    line-height: 1.55;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    align-self: flex-start;
    margin-top: auto;
    padding: .5rem 0 0;
    border: 0;
    background: transparent;
    color: var(--card-accent);
    font-size: .64rem;
    font-weight: 650;
    cursor: pointer;
  }

  .copy-button:hover { color: var(--card-text); }
  .copy-button.copied { color: #37725b; }

  .page-note {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: .8rem;
    color: var(--card-muted);
    font-size: .7rem;
  }

  .page-note p { max-width: 43rem; margin: 0; line-height: 1.7; }
  .page-note code { font-size: .66rem; }
  .page-note a { flex: none; color: var(--card-accent); font-weight: 650; text-decoration: none; }
  .page-note a:hover { text-decoration: underline; text-underline-offset: .2em; }

  :global([data-theme='dark']) .skills-page {
    --card-bg: rgba(32, 35, 33, .72);
    --card-border: #444740;
    --card-text: #e9e7df;
    --card-muted: #a6aba7;
    --card-accent: #9bb5a8;
  }

  :global([data-theme='dark']) .skill-card:hover { border-color: #5b5f57; background: rgba(38, 41, 39, .9); }

  @media (max-width: 58rem) {
    .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 38rem) {
    .page-intro { margin-bottom: 1rem; }
    .skill-grid { grid-template-columns: 1fr; }
    .skill-card { min-height: auto; }
    .page-note { flex-direction: column; gap: .5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-card { transition: none; }
  }
</style>
